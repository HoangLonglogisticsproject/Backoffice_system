# The API this client talks to.
#
# DEVELOPMENT: the backend runs on :3000 while Vite serves this app on :4200,
# so they are different origins and the backend must allowlist :4200 in
# CORS_ORIGINS. The session cookie still travels — SameSite=Strict is about
# the SITE, and both ports are localhost.
#
# PRODUCTION: leave EMPTY. The client is served from the same origin as the
# API, which is why CORS is off there and why same-origin is the shape the
# backend targets.
VITE_API_URL=http://localhost:3000

# ★ THERE IS NO MAP KEY HERE ANY MORE, AND THAT IS THE WHOLE NOTE.
#
# `VITE_GOOGLE_MAPS_API_KEY` used to live on this line. It is gone, along with
# the class of problem it was: a credential that ships INSIDE the bundle, is
# readable by anyone who opens the page, and is defended only by an
# HTTP-referrer rule in somebody's console.
#
# What replaced it:
#   the map      OpenStreetMap tiles drawn by Leaflet. A library, not a
#                service — no key, no quota, no per-load charge. This was the
#                expensive half: every opening of the location dialog used to
#                be a billable map load.
#   the search   a provider with Vietnamese address data, called by the SERVER.
#                Its key is `GOONG_API_KEY` in the backend's own .env and never
#                reaches a browser. See backend/.env.example.
#
# So a frontend build needs nothing configured to locate a place: the pin and
# the two coordinate fields work on their own. Only the address SUGGESTIONS
# depend on the server being given a key.
