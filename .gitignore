# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output — mọi workspace con, không chỉ gốc repo
**/dist
**/tmp
**/out-tsc
**/bazel-out

# Environment — .env là bản cục bộ, .env.example là bản được theo dõi
**/.env
!**/.env.example

# Node
**/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
**/.angular/cache
.sass-cache/
/connect.lock
**/coverage

# Test reports written by the CI commands (`--outputFile`). Ephemeral on a
# runner, but they land here whenever those same commands are run locally.
jest-results.json
vitest-results.json
vitest-integration.json
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

.claude/

# The staging database lives inside the deploy directory on the VPS.
deploy/postgres-data/
