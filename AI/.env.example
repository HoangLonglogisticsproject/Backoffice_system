# AI Platform — biến môi trường. Copy sang .env.
# Thiếu biến bắt buộc thì ứng dụng TỪ CHỐI khởi động (env.schema.ts).

NODE_ENV=development
PORT=3100

# Cùng database với backend, KHÁC schema và KHÁC role (ADR-0007).
#
# PRODUCTION: runtime chạy bằng `ai_app` — SELECT/INSERT/UPDATE trên schema `ai`,
# KHÔNG DELETE, KHÔNG DDL, KHÔNG có quyền trên `public.*`. Migration chạy bằng
# `ai_migrator` ở bước deploy, không phải lúc boot:
#   DATABASE_URL=postgres://ai_migrator:PW@HOST/DB npm run migrate
# Xem scripts/provision-ai-roles.sql.
#
# Giá trị dưới đây là docker-compose cục bộ của backend (superuser) — chỉ dev.
DATABASE_URL=postgres://backoffice:backoffice@localhost:5432/backoffice

# Schema mọi bảng của AI nằm trong. Mặc định `ai`; chỉ integration test đổi.
# Bắt buộc khớp ^[a-z_][a-z0-9_]*$ — một tên khác bị từ chối lúc boot, vì tên
# này được đặt vào search_path và không bao giờ được là một mảnh SQL.
#DB_SCHEMA=ai

# error | warn | log | debug | verbose
LOG_LEVEL=log

# Bearer secret Backend trình ra khi gọi /internal/v1/*. Chỉ MỘT chiều: chiều
# AI → Backend dùng secret khác (SERVICE_TOKEN_AI_TO_BACKEND, phía backend).
# ≥ 32 ký tự. Sinh bằng `openssl rand -hex 32`. KHÔNG commit.
SERVICE_TOKEN_BACKEND_TO_AI=

# Khoá HMAC-SHA256 Backend dùng để ký trusted context của người dùng đi kèm mỗi
# lifecycle action. Khác cả hai bearer secret. ≥ 32 ký tự. KHÔNG commit.
TRUSTED_CONTEXT_SECRET=

# ---- Phase 1b: the scan engine -------------------------------------------
# Mọi biến dưới đây TÙY CHỌN và ĐÓNG khi vắng mặt: service vẫn boot để phục vụ
# Alert API, nhưng scheduler không chạy nếu chưa được cấu hình đầy đủ.

# Read model nội bộ của backend, qua compose network. Rỗng = không có nguồn
# facts nào để đọc, scheduler không arm.
#BACKEND_INTERNAL_URL=http://backend:3000

# Bearer secret service này TRÌNH RA cho backend. KHÁC với
# SERVICE_TOKEN_BACKEND_TO_AI ở trên. ≥ 32 ký tự, `openssl rand -hex 32`.
#SERVICE_TOKEN_AI_TO_BACKEND=

# Một request read-model được phép kéo dài bao lâu trước khi tính là scan lỗi.
#BACKEND_TIMEOUT=10s

# ★ CHƯA ĐƯỢC CEO DUYỆT — không có mặc định. Không đặt = scheduler KHÔNG chạy.
# Quét bao lâu một lần là quyết định nghiệp vụ, service không tự chọn.
#
# Sàn kỹ thuật: >= 1s. Đây KHÔNG PHẢI cadence vận hành — chỉ là ngưỡng dưới
# để một cấu hình sai (0s, 1ms) không biến scheduler thành hot loop. Cadence
# production vẫn TBD.
#
# Để trống (`SCAN_INTERVAL=`) được hiểu là KHÔNG ĐẶT, giống như không khai báo:
# compose render biến host chưa export thành chuỗi rỗng, và service không được
# phép chết vì điều đó. Giá trị có nội dung nhưng sai định dạng vẫn là lỗi boot.
#SCAN_INTERVAL=

# Trễ bao lâu sau khi boot mới quét lần đầu. Mặc định 0s = không trễ (advisory
# lock đã đảm bảo an toàn khi hai replica cùng khởi động).
#SCAN_INITIAL_DELAY=0s

# D1 — ĐÃ DUYỆT (CEO 2026-09-19): cảnh báo khi còn 2 giờ tới pickup_at.
#DETECTOR_UNASSIGNED_TRIP_WARNING_LEAD=2h
# D1 ngưỡng HIGH — CHƯA DUYỆT. Không đặt = detector chỉ phát `warning`.
#DETECTOR_UNASSIGNED_TRIP_HIGH_LEAD=

# ★ D2 — CHƯA DUYỆT. Không đặt = detector D2 BỊ TẮT HOÀN TOÀN.
# "Quá pickup_at bao lâu thì là vấn đề" là quyết định nghiệp vụ; zero KHÔNG
# phải mặc định hợp lệ.
#DETECTOR_STALE_START_GRACE=
#DETECTOR_STALE_START_HIGH_AFTER=

# D3 — ĐÃ DUYỆT (CEO 2026-09-19): cảnh báo sau 12 giờ chờ duyệt.
#DETECTOR_COMPLETION_REVIEW_WARNING_AFTER=12h
# D3 ngưỡng HIGH — CHƯA DUYỆT.
#DETECTOR_COMPLETION_REVIEW_HIGH_AFTER=

# Kích thước kỹ thuật, không phải chính sách. Backend từ chối lookup > 200.
#READ_MODEL_PAGE_SIZE=100
#RESOLUTION_BATCH_SIZE=100
